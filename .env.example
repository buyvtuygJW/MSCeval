# veridic-eval configuration (copy to .env). Everything is optional; defaults
# mirror the app's local docker-compose setup.

# --- data source: the app's Postgres (read-only use) -----------------------
# Falls back to POSTGRES_URL, then the app default. Docker compose publishes the
# container's 5432 on host port 6432; use host `postgres` port 5432 only when the
# eval itself runs inside the compose network.
VERIDIC_EVAL_POSTGRES_URL=postgresql://postgres:admin@localhost:6432/veridic_db

# --- local LLM: Ollama (only used by opt-in llm-judge / phoenix backends) ---
OLLAMA_URL=http://localhost:11434
VERIDIC_EVAL_JUDGE_MODEL=qwen2.5:7b

# --- retrieval eval ---------------------------------------------------------
# Logs-only cap: k must be <= served top_n (default 5).
VERIDIC_EVAL_IR_K=5

# --- faithfulness -----------------------------------------------------------
# lettucedetect (default, local HF model) | ragas | phoenix | none
VERIDIC_EVAL_FAITHFULNESS=lettucedetect
VERIDIC_EVAL_LETTUCE_MODEL=KRLabsOrg/lettucedect-base-modernbert-en-v1
# Only spans with confidence >= threshold count as ungrounded.
VERIDIC_EVAL_LETTUCE_THRESHOLD=0.5
# Where HF caches the LettuceDetect model (set to keep it inside the repo):
HF_HOME=./hf_cache

# --- abstention (RGB Rej) ---------------------------------------------------
# Verbatim RGB marker; scored deterministically via promptfoo echo (offline).
VERIDIC_EVAL_ABSTAIN_MARKER=I can not answer the question because of the insufficient information in documents.
# Set empty to force the pure-python fallback (no Node needed):
VERIDIC_EVAL_PROMPTFOO_CMD=npx -y promptfoo@latest

# --- statistics -------------------------------------------------------------
VERIDIC_EVAL_BOOTSTRAP_N=9999
VERIDIC_EVAL_CONF=0.95
VERIDIC_EVAL_SEED=42
VERIDIC_EVAL_DEEPSIG=0

# --- io ---------------------------------------------------------------------
VERIDIC_EVAL_BENCHMARK=./benchmark.yaml
VERIDIC_EVAL_OUT=./out

# --- telemetry (already forced off in code; listed here for auditability) ---
DO_NOT_TRACK=1
PHOENIX_TELEMETRY_ENABLED=false
OTEL_SDK_DISABLED=true
HF_HUB_DISABLE_TELEMETRY=1
ANONYMIZED_TELEMETRY=false
PROMPTFOO_DISABLE_TELEMETRY=1
# Set once the LettuceDetect model is cached locally to block ALL HF network:
# HF_HUB_OFFLINE=1
